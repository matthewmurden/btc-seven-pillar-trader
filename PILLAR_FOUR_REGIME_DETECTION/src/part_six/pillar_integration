# Canonical mapping: class id -> semantic name (for reference only)
REGIME_ID_TO_NAME = {
    0: "trend_up",
    1: "trend_down",
    2: "chop_low_vol",
    3: "chop_high_vol",
    4: "volatility_expansion",
    5: "volatility_compression",
    6: "liquidity_drought",
    7: "mean_reversion",
}

# Reverse mapping and some aliases to cope with fused/stable labels:
_REGIME_NAME_TO_ID: Dict[str, int] = {
    "trend_up": 0,
    "trend_down": 1,
    "chop_low_vol": 2,
    "chop_high_vol": 3,
    "volatility_expansion": 4,
    "vol_expansion": 4,
    "volatility_compression": 5,
    "vol_compression": 5,
    "liquidity_drought": 6,
    "mean_reversion": 7,
    "mean_revert": 7,
    # some fused outputs may come through literally as "2.0", "3.0", "5.0"
    "2.0": 2,
    "3.0": 3,
    "5.0": 5,
}


def normalise_regime_label(label: Union[int, float, str]) -> int:
    """
    Normalise whatever comes out of Pillar 4 (stable/fused labels) to 0..7.

    Accepts:
      - integer/float IDs: 0, 1, 2, 3, 4, 5, 6, 7 (or 2.0, etc.)
      - string IDs: "0", "1", ... "7"
      - named labels: "liquidity_drought", "volatility_expansion", etc.
    """
    # If it's already an int in range, just return it
    if isinstance(label, int) and 0 <= label <= 7:
        return label

    # If it's a float like 2.0, convert
    if isinstance(label, float) and 0 <= label <= 7 and float(int(label)) == float(label):
        return int(label)

    # If it's a string, try multiple interpretations
    if isinstance(label, str):
        stripped = label.strip()

        # Try direct int parse first ("2", "3", etc.)
        try:
            as_int = int(float(stripped))  # handles "2", "2.0"
            if 0 <= as_int <= 7:
                return as_int
        except ValueError:
            pass

        # Try lookup by semantic name or alias
        lowered = stripped.lower()
        if lowered in _REGIME_NAME_TO_ID:
            return _REGIME_NAME_TO_ID[lowered]

    raise ValueError(f"Cannot normalise regime label '{label}' to 0..7.")


# =============================================================================
# INTEGRATION: PILLAR 1 (ENTRY)
# =============================================================================

def compute_entry_adjustments(
    regime_label: Union[int, float, str],
    regime_confidence: float,
    config: Dict[str, Dict[str, Any]],
) -> Dict[str, Any]:
    """
    Map a regime label to Pillar 1 entry adjustments.

    Parameters
    ----------
    regime_label :
        Regime identifier (0..7) OR fused/stable label string (e.g. "liquidity_drought").
    regime_confidence : float
        Confidence score from Pillar 4 ML / fusion (0..1). Currently not used to
        fade the config, but kept for future extension.
    config : dict
        Configuration loaded from regime_effects_config.json (or DEFAULT_CONFIG).

    Returns
    -------
    dict
        {
          "entry_multiplier": float,
          "trend_alignment_weighting": float,
          "chop_suppression_factor": float,
        }
    """
    regime_id = normalise_regime_label(regime_label)
    key = str(regime_id)
    if key not in config:
        raise ValueError(f"Unknown regime_label '{regime_label}' (normalised={regime_id}) in entry adjustments.")

    entry_cfg = config[key]
    return {
        "entry_multiplier": entry_cfg["entry_multiplier"],
        "trend_alignment_weighting": entry_cfg["trend_alignment_weight"],
        "chop_suppression_factor": entry_cfg["chop_suppression_factor"],
    }



def write_config(path: Path, config: Dict[str, Dict[str, Any]]) -> None:
    """
    One-off helper to materialise regime_effects_config.json.

    The integration functions below are pure; they never write to disk.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as f:
        json.dump(config, f, indent=2)
    logging.info("Wrote regime effects config to %s", path)


def load_config(path: Optional[Path] = None) -> Dict[str, Dict[str, Any]]:
    """
    Load regime effects config. If path is None or missing, fall back to DEFAULT_CONFIG.
    """
    if path is None:
        return DEFAULT_CONFIG

    if not path.exists():
        logging.warning("Config path %s missing, using DEFAULT_CONFIG.", path)
        return DEFAULT_CONFIG

    with path.open("r", encoding="utf-8") as f:
        cfg = json.load(f)

    # ensure string keys
    return {str(k): v for k, v in cfg.items()}



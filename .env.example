# Copy this file to .env in each of these folders and fill in your own values:
#   PILLAR_THREE_RISK_MODEL/src/pipeline/.env
#   PILLAR_FIVE_EXECUTION_ENGINE/src/execution/.env
#   PILLAR_SIX_SAFETY_LAYER/src/safety/.env
# NEVER commit a real .env file.

# --- Binance USD-M Futures API (use DEMO keys) ---
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=
BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com
BINANCE_FUTURES_WS_BASE_URL=wss://fstream.binance.com

# --- Trading defaults ---
BINANCE_FUTURES_SYMBOL=BTCUSDT
BINANCE_FUTURES_RECV_WINDOW=5000
BINANCE_FUTURES_STOP_WORKING_TYPE=MARK_PRICE
BINANCE_FUTURES_PRICE_PROTECT=false
BINANCE_FUTURES_ONE_LIVE_TRADE_PER_SIDE=true
BINANCE_FUTURES_CLIENT_ID_PREFIX=p5_
